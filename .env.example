# dryrun only logs, terraform creates real repositories
PROVISIONER=dryrun

GITHUB_ORG=murops-forge
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# SonarCloud, the worker creates a project for each public repository
SONAR_TOKEN=
SONAR_ORGANIZATION=

# output of `id -u`, lets the worker read the key file
FORGE_UID=1000

# change if 5432 is taken on the host
POSTGRES_PORT=5432
