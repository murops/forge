{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "database", "oidc", "api", "worker", "frontend"],
  "properties": {
    "logLevel": { "enum": ["debug", "info", "warn", "error"] },
    "image": {
      "type": "object",
      "required": ["registry"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "issuer": { "type": "string" },
        "audience": { "type": "string", "minLength": 1 }
      }
    },
    "api": { "$ref": "#/$defs/component" },
    "frontend": {
      "allOf": [{ "$ref": "#/$defs/component" }],
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "concurrency": { "type": "integer", "minimum": 1 },
        "provisioner": { "enum": ["dryrun", "terraform"] },
        "github": {
          "type": "object",
          "properties": {
            "org": { "type": "string", "minLength": 1 },
            "appId": { "type": ["string", "integer"] },
            "installationId": { "type": ["string", "integer"] },
            "privateRulesets": { "type": "boolean" }
          }
        },
        "aws": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilization": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": ["integer", "string"] }
          }
        }
      }
    }
  }
}
