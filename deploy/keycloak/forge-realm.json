{
  "realm": "forge",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "forge-web",
      "name": "Forge",
      "enabled": true,
      "publicClient": false,
      "secret": "forge-web-local-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocolMappers": [
        {
          "name": "forge-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "forge-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      }
    }
  ],
  "users": [
    {
      "username": "dev",
      "email": "dev@forge.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    }
  ]
}
